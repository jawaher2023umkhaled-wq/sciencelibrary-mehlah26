rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('administrator') || (isSignedIn() && request.auth.token.email == 'sciencelibrary8@gmail.com' && request.auth.token.email_verified == true);
    }

    function isReviewer() {
      return hasRole('reviewer') || isAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Resources
    match /resources/{resourceId} {
      // Anyone can read published resources; authors can read their own; reviewers/admins can read all submitted
      allow read: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || isReviewer();

      // Authenticated users can create draft or submitted resources
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && (request.resource.data.status in ['draft', 'submitted'])
        && isValidId(resourceId);

      // Authors can update their own drafts or resources needing revision
      // Reviewers and Admins can update status, notes, and approval
      allow update: if isSignedIn() && (
        isAdmin() ||
        (isReviewer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'publishedAt'])) ||
        (resource.data.authorId == request.auth.uid && resource.data.status in ['draft', 'needs_revision'])
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid && resource.data.status == 'draft');

      // Sub-collection: Reviews
      match /reviews/{reviewId} {
        allow read: if isSignedIn() && (isReviewer() || resource.data.reviewerId == request.auth.uid);
        allow create: if isReviewer() && request.resource.data.reviewerId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // Favorites
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Ratings
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Curricula & Taxonomy (Grades, Subjects, Units, Topics, Types)
    match /curricula/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /grades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /units/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resourceTypes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Immutable Audit Logs: only readable by Admin, append-only by authenticated users, never mutable/deletable
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Connection Health Check
    match /test/{docId} {
      allow read: if true;
    }
  }
}
