rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role check helper against firestore user record
    function hasRole(role) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role);
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('administrator') || (isSignedIn() && request.auth.token.email == 'sciencelibrary8@gmail.com' && request.auth.token.email_verified == true);
    }

    function isReviewer() {
      return hasRole('reviewer') || isAdmin();
    }

    // Public educational assets & thumbnails: readable by everyone
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User resource files: /resources/{userId}/{resourceId}/{fileName}
    match /resources/{userId}/{resourceId}/{fileName} {
      // Author can read their own files; Reviewers and Admins can read for academic review
      allow read: if isOwner(userId) || isReviewer();
      
      // Author can upload: max size 50MB
      allow create: if isOwner(userId) && request.resource.size < 50 * 1024 * 1024;
      
      // Author can update (replace) their own file
      allow update: if isOwner(userId) && request.resource.size < 50 * 1024 * 1024;
      
      // Only author or admin can delete
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
